<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>claude-team</ToolCommandName>
    <PackageId>claude-team</PackageId>
    <Version>0.1.0</Version>
    <Authors>flatrick</Authors>
    <Description>Starts a Claude team leader in a tmux (Linux, WSL) or psmux (Windows) session named after the current repository.</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="claude-team-peer-leaders.md" LogicalName="claude-team-peer-leaders.md" />
  </ItemGroup>

</Project>
