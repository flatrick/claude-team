<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>claude-team</ToolCommandName>
    <PackageId>claude-team</PackageId>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>flatrick</Authors>
    <Description>Starts a Claude team leader in a tmux (Linux, WSL) or psmux (Windows) session named after the current repository.</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="claude-team-peer-leaders.md" LogicalName="claude-team-peer-leaders.md" />
    <EmbeddedResource Include="team-leader.md" LogicalName="team-leader.md" />
  </ItemGroup>

</Project>
