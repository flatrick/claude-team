# Normalise line endings in the repo; check out with LF except where Windows tools need CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
